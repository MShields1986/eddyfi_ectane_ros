<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <group ns="ectane">
        <!-- Nodelet Manager -->
        <node pkg="nodelet" type="nodelet" name="ectane_distributed_reconstruction_nodelet_manager" args="manager" output="screen" >
            <param name="num_worker_threads" value="6" />
        </node>

        <!-- Reconstruction Nodelet
             Threads:
                1 subscriber
                1 publisher
                1 spin 
            -->
        <node pkg="nodelet" type="nodelet" name="distributed_reconstruction_nodelet" 
              args="load eddyfi_ectane/reconstruction_nodelet ectane_distributed_reconstruction_nodelet_manager">
        </node>

    </group>

</launch>