<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- TODO: Consider recording the pointcloud at the array head and doing the reconstruction after the face here -->

    <!-- ROSbag Play -->
    <node pkg="rosbag" type="play" name="bag_player" output="screen" args="-l --clock $(find eddyfi_ectane)/bags/ectane_recording_01.bag"/>

    <!-- Rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find eddyfi_ectane)/config/recon.rviz" />

</launch>