<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <group ns="ectane">
        <arg name="configuration" default="default.yaml" />
        <rosparam file="$(find eddyfi_ectane)/config/$(arg configuration)" command="load" />

        <node pkg="eddyfi_ectane" type="ectane_node" name="ectane_node" output="screen"/>
    </group>
</launch>
