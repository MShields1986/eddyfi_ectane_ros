<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!--
    ##########################################
    #         Configuration Options          #
    ##########################################
    example                                   - Intended for testing with simulated Ectane only
    hf_probe_axial_1_channel
    hf_probe_transversal_1_channel
    hf_probe_axial_and_transversal_1_channel
    hf_probe_axial_and_transversal_4_channels - NOT YET IMPLEMENTED IN ectane_node.cpp
    lf_probe_axial_1_channel
    lf_probe_transversal_1_channel
    lf_probe_axial_and_transversal_1_channel
    lf_probe_axial_and_transversal_4_channels - NOT YET IMPLEMENTED IN ectane_node.cpp
    ##########################################
    -->
    <arg name="configuration" default="lf_probe_axial_and_transversal_1_channel" />
    <arg name="no_robot_mode" default="false" />

    <arg name="rviz" default="false" unless="$(arg no_robot_mode)"/>
    <arg name="rviz" default="true" if="$(arg no_robot_mode)"/>

    <group ns="ectane">
        <!-- Basic Configuration -->
        <group ns="settings">
            <param name="configuration" type="string" value="$(arg configuration)" />
            <param name="no_robot" type="bool" value="$(arg no_robot_mode)" />
            <rosparam file="$(find eddyfi_ectane)/config/settings.yaml" command="load" unless="$(eval configuration == 'example')" />
            <rosparam file="$(find eddyfi_ectane)/config/simulated_ectane_mode_settings.yaml" command="load" if="$(eval configuration == 'example')" />
        </group>
        
        <!-- Crosstalk Rectification Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/crosstalk_$(arg configuration).yaml" command="load" unless="$(eval configuration == 'example')" />
        
        <!-- HF Coil Geometry Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/hf_axial_geometry.yaml" command="load" if="$(eval configuration == 'hf_probe_axial_1_channel')" />

        <rosparam file="$(find eddyfi_ectane)/config/probes/hf_transversal_geometry.yaml" command="load" if="$(eval configuration == 'hf_probe_transversal_1_channel')" />

        <group if="$(eval configuration == 'hf_probe_axial_and_transversal_1_channel')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_transversal_geometry.yaml" command="load" />
        </group>

        <group if="$(eval configuration == 'hf_probe_axial_and_transversal_4_channels')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_transversal_geometry.yaml" command="load" />
        </group>

        <!-- LF Coil Geometry Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/lf_axial_geometry.yaml" command="load" if="$(eval configuration == 'lf_probe_axial_1_channel')" />

        <rosparam file="$(find eddyfi_ectane)/config/probes/lf_transversal_geometry.yaml" command="load" if="$(eval configuration == 'lf_probe_transversal_1_channel')" />

        <group if="$(eval configuration == 'lf_probe_axial_and_transversal_1_channel')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_transversal_geometry.yaml" command="load" />
        </group>

        <group if="$(eval configuration == 'lf_probe_axial_and_transversal_4_channels')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_transversal_geometry.yaml" command="load" />
        </group>

        <!-- Launch Eddyfi Ectane Node -->
        <node pkg="eddyfi_ectane" type="ectane_node" name="ectane_node" output="screen"/>

        <!-- EC Data to Pointcloud at Array -->
        <node pkg="eddyfi_ectane" type="ec_data_to_pointcloud_node" name="ec_data_to_pointcloud_node" output="screen"/>

        <!-- Launch Reconstruction Node -->
        <node pkg="eddyfi_ectane" type="reconstruction_node" name="reconstruction_node" output="screen"/>
    </group>

    <!-- Rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find eddyfi_ectane)/rviz/config.rviz" if="$(arg rviz)" />

</launch>