<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!--
    ##########################################
    #         Configuration Options          #
    ##########################################
    example                                   - Intended for testing with simulated Ectane only
    hf_probe_axial_1_channel
    hf_probe_transversal_1_channel
    hf_probe_axial_and_transversal_1_channel
    hf_probe_axial_and_transversal_4_channels - NOT YET IMPLEMENTED IN ectane_nodelet.cpp
    lf_probe_axial_1_channel
    lf_probe_transversal_1_channel
    lf_probe_axial_and_transversal_1_channel
    lf_probe_axial_and_transversal_4_channels - NOT YET IMPLEMENTED IN ectane_nodelet.cpp
    ##########################################
    -->
    <arg name="configuration" default="lf_probe_axial_and_transversal_1_channel" />
    <arg name="no_robot_mode" default="false" />

    <arg name="rviz" default="false" unless="$(arg no_robot_mode)"/>
    <arg name="rviz" default="true" if="$(arg no_robot_mode)"/>

    <arg name="logging" default="false" />
    <arg name="rosbag_name" default="ectane_recording" />
    <arg name="rosbag_topics" default="[/tf,/ectane/eddy_current_data,/ectane/axial_reconstruction,/ectane/transversal_reconstruction]" />

    <group ns="ectane">
        <!-- Basic Configuration -->
        <group ns="settings">
            <param name="configuration" type="string" value="$(arg configuration)" />
            <param name="no_robot" type="bool" value="$(arg no_robot_mode)" />
            <rosparam file="$(find eddyfi_ectane)/config/settings.yaml" command="load" unless="$(eval configuration == 'example')" />
            <rosparam file="$(find eddyfi_ectane)/config/simulated_ectane_mode.yaml" command="load" if="$(eval configuration == 'example')" />
        </group>
        
        <!-- Crosstalk Rectification Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/crosstalk_$(arg configuration).yaml" command="load" />
        
        <!-- Example Geometry Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/example_geometry.yaml" command="load" if="$(eval configuration == 'example')" />
        
        <!-- HF Coil Geometry Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/hf_axial_geometry.yaml" command="load" if="$(eval configuration == 'hf_probe_axial_1_channel')" />

        <rosparam file="$(find eddyfi_ectane)/config/probes/hf_transversal_geometry.yaml" command="load" if="$(eval configuration == 'hf_probe_transversal_1_channel')" />

        <group if="$(eval configuration == 'hf_probe_axial_and_transversal_1_channel')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_transversal_geometry.yaml" command="load" />
        </group>

        <group if="$(eval configuration == 'hf_probe_axial_and_transversal_4_channels')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/hf_transversal_geometry.yaml" command="load" />
        </group>

        <!-- LF Coil Geometry Configuration -->
        <rosparam file="$(find eddyfi_ectane)/config/probes/lf_axial_geometry.yaml" command="load" if="$(eval configuration == 'lf_probe_axial_1_channel')" />

        <rosparam file="$(find eddyfi_ectane)/config/probes/lf_transversal_geometry.yaml" command="load" if="$(eval configuration == 'lf_probe_transversal_1_channel')" />

        <group if="$(eval configuration == 'lf_probe_axial_and_transversal_1_channel')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_transversal_geometry.yaml" command="load" />
        </group>

        <group if="$(eval configuration == 'lf_probe_axial_and_transversal_4_channels')">
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_axial_geometry.yaml" command="load" />
            <rosparam file="$(find eddyfi_ectane)/config/probes/lf_transversal_geometry.yaml" command="load" />
        </group>



        <!-- Nodelet Manager -->
        <node pkg="nodelet" type="nodelet" name="ectane_nodelet_manager" args="manager" output="screen" >
            <param name="num_worker_threads" value="32" />
        </node>

        <!-- Launch Eddyfi Ectane Nodelet
             Threads:
                2 services
                1 publisher
                1 spin (2 TCP connections which will need dedicated threads outside of nodelet pool) 
            -->
        <node pkg="nodelet" type="nodelet" name="ectane_handler_nodelet" 
              args="load eddyfi_ectane/ectane_nodelet ectane_nodelet_manager">
        </node>

        <!-- EC Data to Pointcloud at Array Head Nodelet
             Threads:
                1 subscriber
                1 publisher
                1 spin 
            -->
        <node pkg="nodelet" type="nodelet" name="ec_data_to_pointcloud_nodelet" 
              args="load eddyfi_ectane/ec_data_to_pointcloud_nodelet ectane_nodelet_manager">
        </node>

        <!-- Reconstruction Nodelet
             Threads:
                1 subscriber
                1 publisher
                1 spin 
            -->
        <!--<node pkg="nodelet" type="nodelet" name="reconstruction_nodelet" 
              args="load eddyfi_ectane/reconstruction_nodelet ectane_nodelet_manager">
        </node>-->


        <!-- Recording Nodelet
             Threads:
                n subscribers
                1 spin 
            -->
        <!-- rosbag record /tf /kmr/amcl_pose /kmr/map /camera/color/pointcloud - -repeat-latched -->
        
        <node pkg="nodelet" type="nodelet" name="rosbag_nodelet" 
              args="load nodelet_rosbag/NodeletRosbag ectane_nodelet_manager" if="$(arg logging)">
            
            <rosparam param="rosbag_record_topics" subst_value="True">$(arg rosbag_topics)</rosparam>
            <param name="rosbag_path" value="$(find eddyfi_ectane)/bags/$(arg rosbag_name).bag" />
        </node>

    </group>

    <!-- Rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find eddyfi_ectane)/rviz/config.rviz" if="$(arg rviz)" />

</launch>